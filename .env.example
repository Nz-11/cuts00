# Copie para .env.local e preencha apenas o que for usar. Todas são opcionais.

# Pasta de dados local (projetos + vídeos enviados). Padrão: ./.data
# CCA_DATA_DIR=

# Liga a API do worker local (/api/worker/*). Sem ela, a API fica desligada.
# Use um valor longo e aleatório; o worker envia "Authorization: Bearer <token>".
# CCA_WORKER_TOKEN=

# Caminho do ffprobe, se não estiver no PATH.
# FFPROBE_PATH=

# Supabase (fase SaaS, ainda não usado) — chaves "anon" são públicas
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Chave de serviço: SOMENTE no servidor. Nunca use prefixo NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# YouTube Data API v3 (opcional, cota gratuita) — só no servidor.
# Não é necessária: o título é confirmado pelo oEmbed oficial, sem chave.
YOUTUBE_API_KEY=

# Worker local de transcrição (worker/). Ele lê este mesmo .env.local.
# Endereço da aplicação. Padrão: http://localhost:3000
# CCA_APP_URL=
# Modelo: tiny | base | small | medium | large-v3 | large-v3-turbo. Padrão: small
# CCA_WHISPER_MODEL=small
# Idioma: pt, en, es… ou auto. Padrão: pt
# CCA_WHISPER_LANGUAGE=pt
# cpu (padrão) | cuda | auto — cuda exige bibliotecas extras da NVIDIA
# CCA_WHISPER_DEVICE=cpu
# int8 (padrão, menos memória) | int8_float32 | float32
# CCA_WHISPER_COMPUTE=int8
# Threads de CPU (padrão: metade dos processadores lógicos)
# CCA_WHISPER_THREADS=
# Busca do decodificador: 5 (padrão, mais preciso) ou 1 (mais rápido)
# CCA_WHISPER_BEAM=5
# Intervalo de consulta da fila, em segundos. Padrão: 5
# CCA_WORKER_POLL_SECONDS=5
# Caminho do ffmpeg, se não estiver no PATH.
# FFMPEG_PATH=
