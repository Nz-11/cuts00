# Copie para .env.local e preencha apenas o que for usar. Todas são opcionais.

# Pasta de dados local (projetos + vídeos enviados). Padrão: ./.data
# CCA_DATA_DIR=

# Liga a API do worker local (/api/worker/*). Sem ela, a API fica desligada.
# Use um valor longo e aleatório; o worker envia "Authorization: Bearer <token>".
# CCA_WORKER_TOKEN=

# Caminho do ffprobe, se não estiver no PATH.
# FFPROBE_PATH=

# Supabase (fase SaaS, ainda não usado) — chaves "anon" são públicas
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Chave de serviço: SOMENTE no servidor. Nunca use prefixo NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# YouTube Data API v3 (opcional, cota gratuita) — só no servidor.
# Não é necessária: o título é confirmado pelo oEmbed oficial, sem chave.
YOUTUBE_API_KEY=

# Worker local de transcrição (worker/). Ele lê este mesmo .env.local.
# Endereço da aplicação. Padrão: http://localhost:3000
# CCA_APP_URL=
# Modelo: tiny | base | small | medium | large-v3 | large-v3-turbo. Padrão: small
# CCA_WHISPER_MODEL=small
# Idioma: pt, en, es… ou auto. Padrão: pt
# CCA_WHISPER_LANGUAGE=pt
# cpu (padrão) | cuda | auto — cuda exige bibliotecas extras da NVIDIA
# CCA_WHISPER_DEVICE=cpu
# int8 (padrão, menos memória) | int8_float32 | float32
# CCA_WHISPER_COMPUTE=int8
# Threads de CPU (padrão: metade dos processadores lógicos)
# CCA_WHISPER_THREADS=
# Busca do decodificador: 5 (padrão, mais preciso) ou 1 (mais rápido)
# CCA_WHISPER_BEAM=5
# Intervalo de consulta da fila, em segundos. Padrão: 5
# CCA_WORKER_POLL_SECONDS=5
# Caminho do ffmpeg, se não estiver no PATH.
# FFMPEG_PATH=

# Seleção de cortes (worker + Ollama local). Nada é enviado para fora deste computador.
# Endereço do Ollama — só são aceitos endereços locais. Padrão: http://127.0.0.1:11434
# CCA_OLLAMA_URL=
# Modelo do Ollama (baixe antes com: ollama pull qwen2.5:7b). Padrão: qwen2.5:7b
# CCA_SELECT_MODEL=qwen2.5:7b
# Duração mínima e máxima de cada corte, em segundos. Padrão: 15 e 90
# CCA_CLIP_MIN_SEC=15
# CCA_CLIP_MAX_SEC=90
# Quantidade máxima de cortes sugeridos por vídeo. Padrão: 10
# CCA_SELECT_MAX_CLIPS=10
# Tamanho de cada parte analisada e sobreposição entre partes, em segundos. Padrão: 480 e 60
# CCA_SELECT_WINDOW_SEC=480
# CCA_SELECT_OVERLAP_SEC=60
# Contexto do modelo, em tokens (mais = mais memória de vídeo). Padrão: 8192
# CCA_SELECT_NUM_CTX=8192

# Renderização (worker + FFmpeg local)
# Velocidade × tamanho do arquivo: ultrafast | superfast | veryfast (padrão) | faster | fast | medium
# CCA_RENDER_PRESET=veryfast
# Qualidade do vídeo (14–32; menor = melhor e maior). Padrão: 20
# CCA_RENDER_CRF=20
# Detector de rosto do enquadramento "Rosto" (YuNet, ONNX). Sem o arquivo, usa o recorte central.
# CCA_FACE_MODEL=models/yunet/face_detection_yunet_2026may.onnx
